"""
PowerPoint generation module for 90D-PPT Generator
Creates branded PowerPoint presentations from processed data
"""

import pandas as pd
from pptx import Presentation
from pptx.util import Inches, Pt
from pptx.dml.color import RGBColor
from pptx.enum.text import PP_ALIGN, MSO_ANCHOR
from pptx.enum.shapes import MSO_SHAPE
import tempfile
from typing import Dict, List, Optional, Tuple
import math

from assets.brand_colors import (
    NAVY, LIGHT_BLUE, GREY, WHITE, BLACK, LIGHT_GREY,
    HEADER_FONT_SIZE, DATA_FONT_SIZE, TITLE_FONT_SIZE, STATUS_SUMMARY_FONT_SIZE,
    PRIMARY_FONT, TITLE_FONT
)


class PowerPointGenerator:
    """Generates branded PowerPoint presentations from processed data"""
    
    def __init__(self):
        # Convert hex colors to RGB tuples
        self.colors = {
            'navy': self._hex_to_rgb(NAVY),
            'light_blue': self._hex_to_rgb(LIGHT_BLUE),
            'grey': self._hex_to_rgb(GREY),
            'white': self._hex_to_rgb(WHITE),
            'black': self._hex_to_rgb(BLACK),
            'light_grey': self._hex_to_rgb(LIGHT_GREY)
        }
        
        # Slide dimensions (Widescreen 16:9 - PowerPoint standard)
        self.slide_width = Inches(13.333)  # 13.333 inches wide
        self.slide_height = Inches(7.5)     # 7.5 inches tall (16:9 ratio)
        
        # Table positioning and sizing - optimized for widescreen format
        self.table_left = Inches(0.5)      # Left margin
        self.table_top = Inches(2.0)       # Below title and status
        self.table_width = Inches(12.3)    # Use most of slide width with margins
        self.table_height = Inches(4.5)    # Adequate height for rows
        
        # Status summary positioning - top right corner as in template
        self.status_summary_left = Inches(10.5)   # Right side positioning
        self.status_summary_top = Inches(0.5)     # Top margin
        self.status_summary_width = Inches(2.5)   # Compact width
        self.status_summary_height = Inches(1.2)  # Adequate height
    
    def _hex_to_rgb(self, hex_color: str) -> Tuple[int, int, int]:
        """Convert hex color to RGB tuple"""
        hex_color = hex_color.lstrip('#')
        return tuple(int(hex_color[i:i+2], 16) for i in (0, 2, 4))
    
    def _apply_rgb_color(self, color_obj, rgb_tuple: Tuple[int, int, int]):
        """Apply RGB color to a color object"""
        color_obj.rgb = RGBColor(*rgb_tuple)
    
    def create_presentation(self, data_by_ranking: Dict[str, pd.DataFrame], 
                          rows_per_slide: int = 10) -> str:
        """
        Create complete PowerPoint presentation
        
        Args:
            data_by_ranking: Dict with ranking as key, DataFrame as value
            rows_per_slide: Number of rows to display per slide
            
        Returns:
            Path to created PowerPoint file
        """
        prs = Presentation()
        
        # Remove default slide layout
        if len(prs.slides) > 0:
            rId = prs.slides._sldIdLst[0].rId
            prs.part.drop_rel(rId)
            del prs.slides._sldIdLst[0]
        
        slide_number = 1
        
        # Process rankings in PRD-specified order
        ranking_order = ['Accepted', 'Up Next', 'Maybe', 'Likely No']
        
        for ranking in ranking_order:
            if ranking not in data_by_ranking or data_by_ranking[ranking].empty:
                continue
                
            df = data_by_ranking[ranking]
            
            # Calculate number of slides needed for this ranking
            num_slides = math.ceil(len(df) / rows_per_slide)
            
            for slide_idx in range(num_slides):
                start_row = slide_idx * rows_per_slide
                end_row = min(start_row + rows_per_slide, len(df))
                slide_data = df.iloc[start_row:end_row]
                
                # Create slide
                slide = self._create_ranking_slide(
                    prs, ranking, slide_data, slide_number,
                    slide_idx + 1, num_slides
                )
                slide_number += 1
        
        # Save presentation to temporary file
        temp_file = tempfile.NamedTemporaryFile(delete=False, suffix='.pptx')
        prs.save(temp_file.name)
        temp_file.close()
        
        return temp_file.name
    
    def _create_ranking_slide(self, prs: Presentation, ranking: str, 
                             data: pd.DataFrame, slide_number: int,
                             ranking_slide_num: int, total_ranking_slides: int) -> object:
        """Create a single slide for a ranking category"""
        
        # Add blank slide
        blank_slide_layout = prs.slide_layouts[6]  # Blank layout
        slide = prs.slides.add_slide(blank_slide_layout)
        
        # Add title
        self._add_slide_title(slide, ranking, ranking_slide_num, total_ranking_slides)
        
        # Add status summary
        self._add_status_summary(slide, data)
        
        # Add main data table
        self._add_data_table(slide, data)
        
        # Add page number
        self._add_page_number(slide, slide_number)
        
        return slide
    
    def _add_slide_title(self, slide, ranking: str, slide_num: int, total_slides: int):
        """Add title to slide with ranking and subtitle"""
        
        # Main title
        title_left = Inches(0.5)
        title_top = Inches(0.2)
        title_width = Inches(8.0)
        title_height = Inches(0.8)
        
        title_box = slide.shapes.add_textbox(title_left, title_top, title_width, title_height)
        title_frame = title_box.text_frame
        title_frame.margin_left = 0
        title_frame.margin_right = 0
        title_frame.margin_top = 0
        title_frame.margin_bottom = 0
        
        # Add green circle icon and title text
        title_p = title_frame.paragraphs[0]
        title_p.alignment = PP_ALIGN.CENTER
        
        # Green circle (using bullet point as substitute)
        circle_run = title_p.add_run()
        circle_run.text = "● "
        circle_run.font.size = Pt(16)
        self._apply_rgb_color(circle_run.font.color, (40, 167, 69))  # Green color
        
        # Title text
        title_run = title_p.add_run()
        title_run.text = f"{ranking} JIRA"
        title_run.font.size = Pt(TITLE_FONT_SIZE)
        title_run.font.bold = True
        self._apply_rgb_color(title_run.font.color, self.colors['navy'])
        title_run.font.name = TITLE_FONT  # Using Aptos Display for slide titles
        
        # Subtitle
        subtitle_top = Inches(1.0)
        subtitle_box = slide.shapes.add_textbox(title_left, subtitle_top, title_width, Inches(0.4))
        subtitle_frame = subtitle_box.text_frame
        subtitle_frame.margin_left = 0
        subtitle_frame.margin_top = 0
        subtitle_frame.margin_bottom = 0
        
        subtitle_p = subtitle_frame.paragraphs[0]
        subtitle_run = subtitle_p.add_run()
        subtitle_text = "Will be worked this 90"
        if total_slides > 1:
            subtitle_text += f" (Page {slide_num} of {total_slides})"
        subtitle_run.text = subtitle_text
        subtitle_run.font.size = Pt(12)
        self._apply_rgb_color(subtitle_run.font.color, self.colors['grey'])
        subtitle_run.font.name = PRIMARY_FONT
    
    def _add_status_summary(self, slide, data: pd.DataFrame):
        """Add status summary in top-right corner"""
        
        # Calculate status counts
        closed_count = 0
        non_closed_count = 0
        
        if '_status_category' in data.columns:
            closed_count = (data['_status_category'] == 'closed').sum()
            non_closed_count = (data['_status_category'] == 'non-closed').sum()
        else:
            # Fallback calculation
            from utils import categorize_status
            if 'status' in data.columns:
                status_counts = data['status'].apply(categorize_status).value_counts()
                closed_count = status_counts.get('closed', 0)
                non_closed_count = status_counts.get('non-closed', 0)
        
        # Create text box with consistent positioning
        summary_box = slide.shapes.add_textbox(
            self.status_summary_left, self.status_summary_top, 
            self.status_summary_width, self.status_summary_height
        )
        summary_frame = summary_box.text_frame
        
        # Consistent margins and formatting
        summary_frame.margin_left = Inches(0.08)
        summary_frame.margin_right = Inches(0.08)
        summary_frame.margin_top = Inches(0.08)
        summary_frame.margin_bottom = Inches(0.08)
        summary_frame.word_wrap = True
        summary_frame.auto_size = None  # Fixed size to ensure consistency
        
        # Add status text with consistent alignment
        p = summary_frame.paragraphs[0]
        p.alignment = PP_ALIGN.LEFT
        
        # Non-closed status line
        run1 = p.add_run()
        run1.text = f"In Progress/On Hold/Pending Review: {non_closed_count}\n"
        run1.font.size = Pt(10)
        self._apply_rgb_color(run1.font.color, self.colors['navy'])
        run1.font.name = "Arial"
        
        # Closed status line
        run2 = p.add_run()
        run2.text = f"Closed: {closed_count}"
        run2.font.size = Pt(10)
        self._apply_rgb_color(run2.font.color, self.colors['navy'])
        run2.font.name = "Arial"
    
    def _add_data_table(self, slide, data: pd.DataFrame):
        """Add main data table to slide"""
        
        # Table columns as per PRD
        table_columns = [
            ('JIRA', 'jira'),
            ('Target Complete Date', 'target_date'),
            ('Description', 'description'), 
            ('Status', 'status'),
            ('Risks/Issues/Watch Items', 'risks'),
            ('Component', 'component')
        ]
        
        rows = len(data) + 1  # +1 for header row
        cols = len(table_columns)
        
        # Create table
        table = slide.shapes.add_table(
            rows, cols, self.table_left, self.table_top, 
            self.table_width, self.table_height
        ).table
        
        # Set column widths with precise measurements for consistency
        # Optimized column widths for widescreen format (12.3 inches total available)
        col_widths = [Inches(1.2), Inches(1.5), Inches(4.0), Inches(1.2), Inches(2.5), Inches(1.9)]
        for i, width in enumerate(col_widths):
            if i < len(table.columns):
                table.columns[i].width = width
        
        # Style header row with consistent formatting
        header_height = Inches(0.4)  # Fixed header height
        for col_idx, (col_name, _) in enumerate(table_columns):
            cell = table.cell(0, col_idx)
            # Set consistent row height for header
            table.rows[0].height = header_height
            self._style_header_cell(cell, col_name)
        
        # Fill data rows with consistent row heights
        data_row_height = Inches(0.3)  # Fixed data row height
        for row_idx, (_, row_data) in enumerate(data.iterrows()):
            # Set consistent row height for data rows
            table.rows[row_idx + 1].height = data_row_height
            
            for col_idx, (_, data_col) in enumerate(table_columns):
                cell = table.cell(row_idx + 1, col_idx)
                
                # Get cell value
                if data_col in row_data:
                    cell_value = str(row_data[data_col]) if pd.notna(row_data[data_col]) else ""
                else:
                    cell_value = ""
                
                self._style_data_cell(cell, cell_value, row_idx % 2 == 0)
    
    def _style_header_cell(self, cell, text: str):
        """Style header cell with consistent brand formatting"""
        # Set background color to black
        fill = cell.fill
        fill.solid()
        self._apply_rgb_color(fill.fore_color, self.colors['black'])
        
        # Set text
        cell.text = text
        
        # Ensure consistent text frame properties
        text_frame = cell.text_frame
        text_frame.word_wrap = True
        text_frame.auto_size = None  # Fixed size for consistency
        
        # Style text with consistent formatting
        for paragraph in text_frame.paragraphs:
            paragraph.alignment = PP_ALIGN.CENTER
            for run in paragraph.runs:
                run.font.size = Pt(HEADER_FONT_SIZE)
                run.font.bold = True
                self._apply_rgb_color(run.font.color, self.colors['white'])
                run.font.name = "Arial"
        
        # Set consistent alignment and anchoring
        cell.text_frame.paragraphs[0].alignment = PP_ALIGN.CENTER
        cell.vertical_anchor = MSO_ANCHOR.MIDDLE
        
        # Set consistent margins across all header cells
        cell.margin_left = Inches(0.05)
        cell.margin_right = Inches(0.05)
        cell.margin_top = Inches(0.05)
        cell.margin_bottom = Inches(0.05)
    
    def _style_data_cell(self, cell, text: str, is_even_row: bool):
        """Style data cell with alternating row colors"""
        # Set background color (alternating)
        fill = cell.fill
        fill.solid()
        if is_even_row:
            self._apply_rgb_color(fill.fore_color, self.colors['light_grey'])
        else:
            self._apply_rgb_color(fill.fore_color, self.colors['white'])
        
        # Set text
        cell.text = text
        
        # Style text
        for paragraph in cell.text_frame.paragraphs:
            for run in paragraph.runs:
                run.font.size = Pt(DATA_FONT_SIZE)
                self._apply_rgb_color(run.font.color, self.colors['black'])
                run.font.name = "Arial"
        
        # Set text alignment
        cell.text_frame.paragraphs[0].alignment = PP_ALIGN.LEFT
        cell.vertical_anchor = MSO_ANCHOR.TOP
        
        # Set margins
        cell.margin_left = Inches(0.05)
        cell.margin_right = Inches(0.05)
        cell.margin_top = Inches(0.05)
        cell.margin_bottom = Inches(0.05)
        
        # Enable text wrapping
        cell.text_frame.word_wrap = True
    
    def _add_page_number(self, slide, slide_number: int):
        """Add page number to slide footer"""
        
        # Page number position (bottom right)
        page_left = Inches(12.0)
        page_top = Inches(7.0)
        page_width = Inches(1.0)
        page_height = Inches(0.4)
        
        page_box = slide.shapes.add_textbox(page_left, page_top, page_width, page_height)
        page_frame = page_box.text_frame
        page_frame.margin_left = 0
        page_frame.margin_top = 0
        
        page_p = page_frame.paragraphs[0]
        page_p.alignment = PP_ALIGN.RIGHT
        
        page_run = page_p.add_run()
        page_run.text = f"P{slide_number}"
        page_run.font.size = Pt(10)
        self._apply_rgb_color(page_run.font.color, self.colors['grey'])
        page_run.font.name = "Arial"
    
    def create_slide_preview(self, data_by_ranking: Dict[str, pd.DataFrame], 
                           rows_per_slide: int = 10) -> List[Dict]:
        """
        Create preview information for slides without generating full PowerPoint
        
        Returns:
            List of slide preview dictionaries
        """
        previews = []
        slide_number = 1
        ranking_order = ['Accepted', 'Up Next', 'Maybe', 'Likely No']
        
        for ranking in ranking_order:
            if ranking not in data_by_ranking or data_by_ranking[ranking].empty:
                continue
                
            df = data_by_ranking[ranking]
            
            # Calculate slides for this ranking
            num_slides = math.ceil(len(df) / rows_per_slide)
            
            for slide_idx in range(num_slides):
                start_row = slide_idx * rows_per_slide
                end_row = min(start_row + rows_per_slide, len(df))
                slide_data = df.iloc[start_row:end_row]
                
                # Calculate status counts
                closed_count = 0
                non_closed_count = 0
                
                if '_status_category' in slide_data.columns:
                    closed_count = (slide_data['_status_category'] == 'closed').sum()
                    non_closed_count = (slide_data['_status_category'] == 'non-closed').sum()
                
                preview = {
                    'slide_number': slide_number,
                    'ranking': ranking,
                    'slide_of_ranking': f"{slide_idx + 1}/{num_slides}",
                    'row_count': len(slide_data),
                    'closed_count': closed_count,
                    'non_closed_count': non_closed_count,
                    'data_preview': slide_data.head(3).to_dict('records') if len(slide_data) > 0 else []
                }
                
                previews.append(preview)
                slide_number += 1
        
        return previews