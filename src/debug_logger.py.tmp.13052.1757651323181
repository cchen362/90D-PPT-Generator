"""
Debug logging system for 90D-PPT Generator
Provides comprehensive logging and debugging functionality for troubleshooting
"""

import logging
import streamlit as st
from typing import Any, Dict, List, Optional
from datetime import datetime
from pathlib import Path
import json
import traceback
from functools import wraps


class DebugLogger:
    """Comprehensive debug logging system"""
    
    def __init__(self, log_level: str = "INFO"):
        self.logger = logging.getLogger("90D-PPT-Generator")
        self.logger.setLevel(getattr(logging, log_level.upper()))
        
        # Create formatter
        formatter = logging.Formatter(
            '%(asctime)s - %(name)s - %(levelname)s - %(funcName)s:%(lineno)d - %(message)s'
        )
        
        # Create console handler
        if not self.logger.handlers:
            console_handler = logging.StreamHandler()
            console_handler.setLevel(logging.DEBUG)
            console_handler.setFormatter(formatter)
            self.logger.addHandler(console_handler)
        
        # Initialize session debug info
        if 'debug_info' not in st.session_state:
            st.session_state.debug_info = {
                'session_start': datetime.now().isoformat(),
                'steps_completed': [],
                'errors': [],
                'warnings': [],
                'file_info': {},
                'performance_metrics': {}
            }
    
    def log_step_start(self, step_number: int, step_name: str):
        """Log when a step starts"""
        self.logger.info(f"Starting Step {step_number}: {step_name}")
        st.session_state.debug_info['steps_completed'].append({
            'step': step_number,
            'name': step_name,
            'start_time': datetime.now().isoformat(),
            'status': 'started'
        })
    
    def log_step_complete(self, step_number: int, step_name: str):
        """Log when a step completes"""
        self.logger.info(f"Completed Step {step_number}: {step_name}")
        
        # Update the step status
        for step in st.session_state.debug_info['steps_completed']:
            if step['step'] == step_number:
                step['status'] = 'completed'
                step['end_time'] = datetime.now().isoformat()
                break
    
    def log_error(self, error: Exception, context: str = ""):
        """Log an error with full context"""
        error_info = {
            'timestamp': datetime.now().isoformat(),
            'type': type(error).__name__,
            'message': str(error),
            'context': context,
            'traceback': traceback.format_exc()
        }
        
        self.logger.error(f"Error in {context}: {error}", exc_info=True)
        st.session_state.debug_info['errors'].append(error_info)
        
        return error_info
    
    def log_warning(self, message: str, context: str = ""):
        """Log a warning"""
        warning_info = {
            'timestamp': datetime.now().isoformat(),
            'message': message,
            'context': context
        }
        
        self.logger.warning(f"Warning in {context}: {message}")
        st.session_state.debug_info['warnings'].append(warning_info)
        
        return warning_info
    
    def log_file_info(self, filename: str, size_mb: float, file_type: str, sheet_names: List[str] = None):
        """Log file processing information"""
        file_info = {
            'filename': filename,
            'size_mb': size_mb,
            'type': file_type,
            'sheet_names': sheet_names or [],
            'processed_at': datetime.now().isoformat()
        }
        
        self.logger.info(f"Processing file: {filename} ({size_mb:.2f}MB, {file_type})")
        st.session_state.debug_info['file_info'] = file_info
        
        return file_info
    
    def log_data_info(self, rows: int, columns: int, mappings: Dict[str, str]):
        """Log data processing information"""
        data_info = {
            'rows': rows,
            'columns': columns,
            'mappings': mappings,
            'processed_at': datetime.now().isoformat()
        }
        
        self.logger.info(f"Data processed: {rows} rows, {columns} columns")
        st.session_state.debug_info['data_info'] = data_info
        
        return data_info
    
    def log_performance(self, operation: str, duration_seconds: float):
        """Log performance metrics"""
        perf_info = {
            'operation': operation,
            'duration_seconds': duration_seconds,
            'timestamp': datetime.now().isoformat()
        }
        
        self.logger.info(f"Performance - {operation}: {duration_seconds:.2f}s")
        
        if 'operations' not in st.session_state.debug_info['performance_metrics']:
            st.session_state.debug_info['performance_metrics']['operations'] = []
        
        st.session_state.debug_info['performance_metrics']['operations'].append(perf_info)
        
        return perf_info
    
    def get_debug_summary(self) -> Dict[str, Any]:
        """Get complete debug summary"""
        return st.session_state.debug_info
    
    def render_debug_panel(self):
        """Render debug information panel in Streamlit"""
        if st.sidebar.checkbox("🐛 Show Debug Info"):
            st.sidebar.markdown("### Debug Information")
            
            debug_info = self.get_debug_summary()
            
            # Session info
            st.sidebar.markdown(f"**Session:** {debug_info.get('session_start', 'Unknown')[:19]}")
            
            # Current step
            current_step = st.session_state.get('current_step', 1)
            st.sidebar.markdown(f"**Current Step:** {current_step}/6")
            
            # Error count
            error_count = len(debug_info.get('errors', []))
            warning_count = len(debug_info.get('warnings', []))
            
            if error_count > 0:
                st.sidebar.error(f"❌ {error_count} error(s)")
            if warning_count > 0:
                st.sidebar.warning(f"⚠️ {warning_count} warning(s)")
            
            # File info
            file_info = debug_info.get('file_info', {})
            if file_info:
                st.sidebar.markdown(f"**File:** {file_info.get('filename', 'N/A')}")
                st.sidebar.markdown(f"**Size:** {file_info.get('size_mb', 0):.2f}MB")
            
            # Performance
            perf_metrics = debug_info.get('performance_metrics', {})
            operations = perf_metrics.get('operations', [])
            if operations:
                total_time = sum(op.get('duration_seconds', 0) for op in operations)
                st.sidebar.markdown(f"**Total Processing:** {total_time:.2f}s")
            
            # Detailed debug
            if st.sidebar.button("📋 Show Full Debug Log"):
                st.sidebar.json(debug_info)
    
    def export_debug_info(self) -> str:
        """Export debug information as JSON string"""
        debug_info = self.get_debug_summary()
        return json.dumps(debug_info, indent=2, default=str)


def debug_function(logger: DebugLogger):
    """Decorator to add debug logging to functions"""
    def decorator(func):
        @wraps(func)
        def wrapper(*args, **kwargs):
            func_name = func.__name__
            start_time = datetime.now()
            
            logger.logger.debug(f"Starting function: {func_name}")
            
            try:
                result = func(*args, **kwargs)
                
                duration = (datetime.now() - start_time).total_seconds()
                logger.log_performance(func_name, duration)
                
                return result
                
            except Exception as e:
                logger.log_error(e, f"Function: {func_name}")
                raise
                
        return wrapper
    return decorator


# Global debug logger instance
debug_logger = DebugLogger()